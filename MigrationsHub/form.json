{
  "elements": [
    {
      "type": "Label",
      "caption": "Schritt 1: Alt-Instanz (migrieren von) und Neu-Instanz (migrieren nach) wählen"
    },
    {
      "type": "RowLayout",
      "items": [
        {
          "type": "SelectInstance",
          "name": "SourceInstanceID",
          "caption": "Alt-Instanz"
        },
        {
          "type": "SelectInstance",
          "name": "TargetInstanceID",
          "caption": "Neu-Instanz (nur zur Orientierung — Zielvariable wird in Schritt 3 direkt gesucht)"
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Alt-Datenpunkte laden",
      "onClick": "MIGHUB_LoadSourceVariables($id, $SourceInstanceID);"
    },
    {
      "type": "Label",
      "caption": "Schritt 2: gewünschte Alt-Datenpunkte ankreuzen und übernehmen"
    },
    {
      "type": "List",
      "name": "SourceVariables",
      "caption": "Alt-Datenpunkte",
      "rowCount": 10,
      "add": false,
      "delete": false,
      "sort": {
        "column": "Ident",
        "direction": "ascending"
      },
      "columns": [
        {
          "caption": "Auswahl",
          "name": "Selected",
          "width": "80px",
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "caption": "Ident",
          "name": "Ident",
          "width": "200px"
        },
        {
          "caption": "Name",
          "name": "Name",
          "width": "auto"
        },
        {
          "caption": "Referenzen",
          "name": "References",
          "width": "160px"
        },
        {
          "caption": "VariableID",
          "name": "VariableID",
          "width": "100px",
          "visible": false
        }
      ],
      "values": []
    },
    {
      "type": "Button",
      "caption": "Ausgewählte Alt-Datenpunkte → in Migrationsliste übernehmen",
      "onClick": "MIGHUB_AddSourceVariablesToMigrations($id, $SourceVariables, $Migrations, $TargetInstanceID);"
    },
    {
      "type": "Label",
      "caption": "Schritt 3: Zielvorschläge (anhand gleichem Ident) prüfen, fehlende Ziele über das Suchfeld wählen (Klick auf die Zeile → Variablenauswahl)"
    },
    {
      "type": "List",
      "name": "Migrations",
      "caption": "Zu migrierende Variablenpaare",
      "rowCount": 10,
      "add": true,
      "delete": true,
      "columns": [
        {
          "caption": "Alte Variable",
          "name": "OldVariableID",
          "width": "300px",
          "add": 0,
          "edit": {
            "type": "SelectVariable"
          }
        },
        {
          "caption": "Neue Variable",
          "name": "NewVariableID",
          "width": "300px",
          "add": 0,
          "edit": {
            "type": "SelectVariable"
          }
        },
        {
          "caption": "Status",
          "name": "Status",
          "width": "200px",
          "add": ""
        },
        {
          "caption": "Referenzen (Alt-Variable)",
          "name": "References",
          "width": "auto",
          "add": ""
        }
      ],
      "values": []
    },
    {
      "type": "Label",
      "caption": "Achtung: Der Vorgang überträgt Archivhistorie (AC_ChangeVariableID) und Verknüpfungen unwiderruflich auf die neuen Variablen und kann nicht automatisch rückgängig gemacht werden."
    },
    {
      "type": "CheckBox",
      "name": "Confirmed",
      "caption": "Ich habe die Zuordnung oben geprüft und bin sicher, dass sie korrekt ist"
    },
    {
      "type": "Button",
      "caption": "Migration jetzt ausführen",
      "confirm": "Dieser Vorgang überträgt Archivhistorie und Verknüpfungen unwiderruflich auf die neuen Variablen. Wirklich fortfahren?",
      "onClick": "MIGHUB_RunMigrations($id, $Confirmed, $Migrations);"
    },
    {
      "type": "Label",
      "caption": "Ergebnis / Plausibilitätsprüfung (aktueller Wert alt vs. neu nach der Migration)"
    },
    {
      "type": "List",
      "name": "Results",
      "caption": "Ergebnisse",
      "rowCount": 10,
      "add": false,
      "delete": false,
      "columns": [
        {
          "caption": "Alte Variable",
          "name": "OldName",
          "width": "200px"
        },
        {
          "caption": "Neue Variable",
          "name": "NewName",
          "width": "200px"
        },
        {
          "caption": "Erfolg",
          "name": "Success",
          "width": "80px"
        },
        {
          "caption": "Grund",
          "name": "Reason",
          "width": "200px"
        },
        {
          "caption": "Wert alt",
          "name": "OldValue",
          "width": "120px"
        },
        {
          "caption": "Wert neu",
          "name": "NewValue",
          "width": "120px"
        },
        {
          "caption": "Plausibel",
          "name": "Plausible",
          "width": "100px"
        }
      ],
      "values": []
    }
  ]
}
