{
  "elements": [
    {
      "type": "Label",
      "caption": "Schritt 1: Alt-Instanz (migrieren von) und Neu-Instanz (migrieren nach) wählen"
    },
    {
      "type": "RowLayout",
      "items": [
        {
          "type": "SelectInstance",
          "name": "SourceInstanceID",
          "caption": "Alt-Instanz"
        },
        {
          "type": "SelectInstance",
          "name": "TargetInstanceID",
          "caption": "Neu-Instanz (nur zur Orientierung — Zielvariable wird in Schritt 3 direkt gesucht)"
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Alt-Datenpunkte laden",
      "onClick": "MIGHUB_LoadSourceVariables($id, $SourceInstanceID);"
    },
    {
      "type": "Label",
      "caption": "Schritt 2: gewünschte Alt-Datenpunkte ankreuzen und übernehmen"
    },
    {
      "type": "List",
      "name": "SourceVariables",
      "caption": "Alt-Datenpunkte",
      "rowCount": 10,
      "add": false,
      "delete": false,
      "sort": {
        "column": "Ident",
        "direction": "ascending"
      },
      "columns": [
        {
          "caption": "Auswahl",
          "name": "Selected",
          "width": "80px",
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "caption": "Ident",
          "name": "Ident",
          "width": "200px"
        },
        {
          "caption": "Name",
          "name": "Name",
          "width": "auto"
        },
        {
          "caption": "Referenzen",
          "name": "References",
          "width": "160px"
        },
        {
          "caption": "VariableID",
          "name": "VariableID",
          "width": "100px",
          "visible": false
        }
      ],
      "values": []
    },
    {
      "type": "RowLayout",
      "items": [
        {
          "type": "Button",
          "caption": "Alle auswählen",
          "onClick": "MIGHUB_SetAllSourceVariablesSelected($id, $SourceVariables, true);"
        },
        {
          "type": "Button",
          "caption": "Alle abwählen",
          "onClick": "MIGHUB_SetAllSourceVariablesSelected($id, $SourceVariables, false);"
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Ausgewählte Alt-Datenpunkte → in Migrationsliste übernehmen",
      "onClick": "MIGHUB_AddSourceVariablesToMigrations($id, $SourceVariables, $Migrations, $TargetInstanceID);"
    },
    {
      "type": "Label",
      "caption": "Schritt 3: Zielvorschläge (anhand gleichem Ident) prüfen, fehlende Ziele über das Suchfeld wählen (Klick auf die Zeile → Variablenauswahl)"
    },
    {
      "type": "List",
      "name": "Migrations",
      "caption": "Zu migrierende Variablenpaare",
      "rowCount": 10,
      "add": true,
      "delete": true,
      "columns": [
        {
          "caption": "Alte Variable",
          "name": "OldVariableID",
          "width": "300px",
          "add": 0,
          "edit": {
            "type": "SelectVariable"
          }
        },
        {
          "caption": "Neue Variable",
          "name": "NewVariableID",
          "width": "300px",
          "add": 0,
          "edit": {
            "type": "SelectVariable"
          }
        },
        {
          "caption": "Status",
          "name": "Status",
          "width": "200px",
          "add": ""
        },
        {
          "caption": "Referenzen (Alt-Variable)",
          "name": "References",
          "width": "auto",
          "add": ""
        }
      ],
      "values": []
    },
    {
      "type": "Button",
      "caption": "Migrationsliste leeren",
      "confirm": "Alle Zeilen aus der Migrationsliste entfernen?",
      "onClick": "MIGHUB_ClearMigrations($id);"
    },
    {
      "type": "Label",
      "caption": "Wichtig: Archiv und WebFront-Verknüpfungen werden automatisch migriert. Skripte, Ereignisse, IPSView-Kacheln, Workflows (IPSWorkflowEditor) und Einstellungen anderer Module (die eine Variablen-ID fest referenzieren) NICHT — dafür dient die folgende Suche als Prüfliste zur manuellen Kontrolle."
    },
    {
      "type": "Button",
      "caption": "Referenzen suchen (Skripte/Ereignisse)",
      "onClick": "MIGHUB_ScanReferences($id, $Migrations);"
    },
    {
      "type": "Label",
      "caption": "Skript-Funde — zum Bearbeiten die Schaltflächen unter der Liste nutzen (öffnen das Skript direkt; nach erneuter Suche das Formular einmal neu öffnen)"
    },
    {
      "type": "List",
      "name": "ScriptChecks",
      "caption": "Skripte mit möglichem Bezug zur Alt-Variable",
      "rowCount": 8,
      "add": false,
      "delete": true,
      "onEdit": "MIGHUB_SaveScriptChecks($id, $ScriptChecks);",
      "columns": [
        {
          "caption": "Alte Variable",
          "name": "OldName",
          "width": "200px",
          "add": ""
        },
        {
          "caption": "Skript",
          "name": "ObjectID",
          "width": "auto",
          "edit": {
            "type": "SelectScript"
          }
        },
        {
          "caption": "Erledigt",
          "name": "Done",
          "width": "100px",
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "caption": "OldVariableID",
          "name": "OldVariableID",
          "width": "80px",
          "visible": false,
          "add": 0
        }
      ],
      "values": []
    },
    {
      "type": "Label",
      "caption": "Ereignis-Funde — zum Bearbeiten die Schaltflächen unter der Liste nutzen (öffnen das Ereignis direkt; nach erneuter Suche das Formular einmal neu öffnen)"
    },
    {
      "type": "List",
      "name": "EventChecks",
      "caption": "Ereignisse, die durch die Alt-Variable ausgelöst werden",
      "rowCount": 8,
      "add": false,
      "delete": true,
      "onEdit": "MIGHUB_SaveEventChecks($id, $EventChecks);",
      "columns": [
        {
          "caption": "Alte Variable",
          "name": "OldName",
          "width": "200px",
          "add": ""
        },
        {
          "caption": "Ereignis",
          "name": "ObjectID",
          "width": "auto",
          "edit": {
            "type": "SelectEvent"
          }
        },
        {
          "caption": "Erledigt",
          "name": "Done",
          "width": "100px",
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "caption": "OldVariableID",
          "name": "OldVariableID",
          "width": "80px",
          "visible": false,
          "add": 0
        }
      ],
      "values": []
    },
    {
      "type": "Button",
      "caption": "Migration simulieren (Probelauf — schreibt nichts)",
      "onClick": "MIGHUB_SimulateMigrations($id, $Migrations);"
    },
    {
      "type": "Label",
      "caption": "Achtung: \"Migration jetzt ausführen\" überträgt Archivhistorie (AC_ChangeVariableID) und Verknüpfungen unwiderruflich auf die neuen Variablen und kann nicht automatisch rückgängig gemacht werden. Vorher unbedingt simulieren."
    },
    {
      "type": "CheckBox",
      "name": "Confirmed",
      "caption": "Ich habe die Zuordnung oben geprüft (inkl. Simulation) und bin sicher, dass sie korrekt ist"
    },
    {
      "type": "Button",
      "caption": "Migration jetzt ausführen",
      "confirm": "Dieser Vorgang überträgt Archivhistorie und Verknüpfungen unwiderruflich auf die neuen Variablen. Wirklich fortfahren?",
      "onClick": "MIGHUB_RunMigrations($id, $Confirmed, $Migrations);"
    },
    {
      "type": "Label",
      "caption": "Ergebnis / Plausibilitätsprüfung (aktueller Wert alt vs. neu nach der Migration)"
    },
    {
      "type": "List",
      "name": "Results",
      "caption": "Ergebnisse",
      "rowCount": 10,
      "add": false,
      "delete": false,
      "columns": [
        {
          "caption": "Alte Variable",
          "name": "OldName",
          "width": "200px",
          "add": ""
        },
        {
          "caption": "Neue Variable",
          "name": "NewName",
          "width": "200px"
        },
        {
          "caption": "Erfolg",
          "name": "Success",
          "width": "80px"
        },
        {
          "caption": "Grund",
          "name": "Reason",
          "width": "auto"
        },
        {
          "caption": "Wert alt",
          "name": "OldValue",
          "width": "120px"
        },
        {
          "caption": "Wert neu",
          "name": "NewValue",
          "width": "120px"
        },
        {
          "caption": "Plausibel",
          "name": "Plausible",
          "width": "100px"
        }
      ],
      "values": []
    },
    {
      "type": "ExpansionPanel",
      "caption": "Instanz analysieren & löschen",
      "items": [
        {
          "type": "Label",
          "caption": "Vor dem Löschen einer Alt-Instanz alle Abhängigkeiten prüfen. Hängen weitere Instanzen als Verbindungskinder (Transport) daran, wird das Löschen hart blockiert — sonst reißt es den Bus unter einem laufenden Gerätebaum weg."
        },
        {
          "type": "SelectInstance",
          "name": "AnalyzeInstanceID",
          "caption": "Zu prüfende Instanz"
        },
        {
          "type": "Button",
          "caption": "Instanz analysieren",
          "onClick": "MIGHUB_AnalyzeInstance($id, $AnalyzeInstanceID);"
        },
        {
          "type": "List",
          "name": "InstanceReport",
          "caption": "Abhängigkeits-Report",
          "rowCount": 10,
          "add": false,
          "delete": false,
          "columns": [
            {
              "caption": "Kategorie",
              "name": "Category",
              "width": "220px"
            },
            {
              "caption": "Fund",
              "name": "Detail",
              "width": "auto"
            },
            {
              "caption": "Objekt-ID",
              "name": "ObjectID",
              "width": "100px"
            },
            {
              "caption": "Schweregrad",
              "name": "Severity",
              "width": "120px"
            }
          ],
          "values": []
        },
        {
          "type": "CheckBox",
          "name": "DeleteConfirmed",
          "caption": "Ich habe den Report geprüft und will die Instanz trotz gemeldeter Warnungen löschen"
        },
        {
          "type": "Button",
          "caption": "Instanz jetzt löschen",
          "confirm": "Die gewählte Instanz wird unwiderruflich gelöscht (samt Kindvariablen). Transport-Abhängigkeiten blockieren das Löschen; Warnungen werden überstimmt. Wirklich fortfahren?",
          "onClick": "MIGHUB_DeleteInstanceChecked($id, $AnalyzeInstanceID, $DeleteConfirmed);"
        }
      ]
    }
  ]
}
